# Server
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional: comma-separated list if you need more than one allowed origin
# (e.g. testing from your phone on the same network). Defaults to CLIENT_URL.
# ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173

# MongoDB (self-hosted -> no limits. e.g. mongodb://localhost:27017/easytalk)
MONGO_URI=mongodb://localhost:27017/easytalk

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Ollama (local AI, self-hosted, unlimited, no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Uploads
UPLOAD_DIR=uploads

# Push notifications (free, self-hosted Web Push via VAPID — no Firebase/APNs account).
# Generate a keypair once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com

# Google Contacts import (People API) - free, generous quota, no billing needed for this use
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
